{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/Dockerfile",
    "watchPatterns": [
      "/manhwa-recap-v1/*",
      "/manhwa-recap-v1/review_ui/**",
      "/manhwa-recap-v1/hyperframes/**",
      "/manhwa-recap-v1/eval/**",
      "/manhwa-recap-v1/input/**",
      "/panel-split/**",
      "/panel-describe/**",
      "/deploy/**",
      "/scripts/**",
      "/fixtures/**",
      "/railway.json",
      "/.dockerignore"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
